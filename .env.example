"""
Template de variáveis de ambiente.
Copie este arquivo para .env e configure com seus valores.
"""

# Flask
FLASK_ENV=development

# Database
DB_USER=postgres
DB_PASSWORD=sua_senha_super_secreta
DB_HOST=localhost
DB_PORT=5432
DB_NAME=adocao_gatos

# JWT
JWT_SECRET_KEY=sua_chave_jwt_super_secreta_min_32_caracteres

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Upload
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760

# Google Cloud Storage (deixe vazio para usar local)
GCS_BUCKET=

# Desenvolvimento
DEBUG=True
